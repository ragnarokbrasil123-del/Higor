# ============================================================
#  Variáveis de ambiente do Clube Olimpo
#
#  Copie este arquivo para `.env.local` (que o .gitignore já ignora)
#  e preencha. Em produção, os mesmos nomes vão em
#  Vercel → Settings → Environment Variables.
# ============================================================

# ---------------- Supabase: chave privilegiada ----------------
#
# Supabase → Settings → API → `service_role` (secret).
#
# ⚠️ Esta chave IGNORA RLS e lê a base inteira. Ela é o próprio
# contorno do RLS, então:
#   - NUNCA use o prefixo NEXT_PUBLIC_ (isso a embutiria no bundle
#     do navegador e publicaria a base inteira);
#   - só pode ser lida dentro de app/api/ (ver lib/supabase-admin.ts);
#   - se vazar, rotacione no painel do Supabase.
#
# Enquanto estiver vazia, /api/login-responsavel responde 503 e o
# login cai no caminho antigo (senha conferida no navegador), com
# aviso no console. O app funciona, mas o RLS não pode ser ligado.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- Segredo da sessão ----------------
#
# Assina o cookie de sessão (HMAC-SHA256). Gere com:
#
#     openssl rand -base64 48
#
# ⚠️ Quem tiver este segredo FORJA uma sessão de admin e passa por
# todas as rotas. Guarde como senha. Sem prefixo NEXT_PUBLIC_.
#
# Trocar o valor derruba todas as sessões abertas: todo mundo
# precisa entrar de novo (a credencial continua a mesma).
SESSION_SECRET=

# ---------------- Notificações push (VAPID) ----------------
#
# ATENÇÃO: a chave privada antiga ficou escrita dentro do código em
# app/api/push/route.ts e o repositório é público. Ela tem de ser
# considerada vazada. Não reaproveite: GERE UM PAR NOVO com
#
#     npx web-push generate-vapid-keys
#
# e cole o resultado abaixo. Depois de trocar o par, os aparelhos já
# inscritos param de receber aviso e precisam tocar em "Ativar avisos"
# de novo — as inscrições antigas foram assinadas com a chave velha.
#
# A pública também vem daqui para não existirem duas fontes: se o
# navegador se inscrever com uma pública e o servidor assinar com outra
# privada, o push falha em silêncio em todos os aparelhos.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Quem o serviço de push procura em caso de problema. Precisa ser um
# mailto: ou uma URL válida.
VAPID_SUBJECT=mailto:contato@clubeolimpo.com
